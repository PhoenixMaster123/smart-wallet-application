<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
    Per-file rule exclusions. Keep this list short and justified - a growing
    suppressions file usually means the rule itself is wrong.
-->
<suppressions>

    <!-- Spring Boot entry points hold only a static main, which is exactly the
         shape HideUtilityClassConstructor complains about. They are not utility
         classes: Spring instantiates them as a configuration bean. -->
    <suppress files=".*Application\.java" checks="HideUtilityClassConstructor"/>

    <!-- Lombok's @UtilityClass already makes the class final and hides its
         constructor, but Checkstyle reads source, not the generated bytecode. -->
    <suppress files=".*(EmailUtils|WalletUtils|DtoMapper)\.java" checks="HideUtilityClassConstructor|FinalClass"/>

    <!-- Tests name themselves whenX_andY_thenZ, which reads far better than the
         camelCase the rule wants. The convention is deliberate, so exempt tests. -->
    <suppress files=".*(UTest|Tests)\.java" checks="MethodName"/>

    <!-- Those same names, plus the @DisplayName sentence beside them, run past
         120 characters and cannot be wrapped - a method name has no line break. -->
    <suppress files=".*(UTest|Tests)\.java" checks="LineLength"/>

</suppressions>
